;; Fades a LED on each of 4 pins, in turn: up, then down, each fade
;; after a key of the IR remote. Prints the free memory and the steps
;; of the clock per second.
;;
;; The same program as atm/init.atm (the Lua version), for ia-atmos/lang
;; with the environment env/esp32.atm.

spawn debug.Mem()
spawn debug.Fps()

ir.start(15)

gpio.setup_pwm(0, 25000, 10)

loop _, p in [19, 18, 4, 23] {
    gpio.attach_pwm(p, 0)
    gpio.write_pwm(0, 0)

    gpio.fade_pwm(0, 1023, 2000)
    await :gpio.pwm_fade
    await :ir [repeat=false]

    gpio.fade_pwm(0, 0, 2000)
    await :gpio.pwm_fade
    await :ir [repeat=false]

    gpio.detach_pwm(p)
}
