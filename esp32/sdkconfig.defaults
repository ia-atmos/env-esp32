CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# the program runs in app_main: the runtime recurses on the C stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# 1 ms ticks: the clock waits in ticks (drv/esp32/clock.c)
CONFIG_FREERTOS_HZ=1000

# Wi-Fi (ESP-NOW): the buffers of the Lua version, to save internal RAM
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_TX_BA_WIN=2
CONFIG_ESP_WIFI_RX_BA_WIN=2
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
