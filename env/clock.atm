;; The clock: the primary environment.
;;
;; Each step waits until the nearest timer of the program, or until a
;; driver has an event, and lets the time that passed pass in the
;; program, in microseconds. `clock.now` is the time since boot.

```:prelude
// the time in the unit of the program (A_TIME_US microseconds each),
// with the rest kept for the next step
static int64_t esp_clk_rest = 0;
static int64_t esp_clock_step (AVal nxt) {
    int64_t max = (nxt.type == A_NIL) ? -1 : (int64_t) (a_dbl(nxt) * A_TIME_US);
    int64_t dt = drv_clock_wait(max);
    if (dt < 0) {
        return -1;
    }
    dt += esp_clk_rest;
    esp_clk_rest = dt % A_TIME_US;
    return dt / A_TIME_US;
}
```

val clock = [now=0]

atmos.env([
    mode = [primary=true],
    step = func () {
        val nxt = atmos.next()
        val dt = `:number esp_clock_step($nxt)`
        set clock.now = `:number drv_clock_now() / A_TIME_US`
        if dt < 0 {
            true            ;; nothing can happen anymore (only the host)
        } else {
            if dt > 0 {
                emit(dt)
            }
            false
        }
    },
])
