;; The ESP32 environment: one environment for the board.
;;
;; Its step waits until the nearest timer of the program, or until a
;; driver queues an event; lets the time that passed pass in the program;
;; then emits the events that the drivers queued, in the order they
;; happened, whatever driver queued them.
;;
;; This file is the core. A program includes the modules it uses, each
;; of which includes this file:
;;
;;      include "<repo>/env/gpio.atm"           ;; gpio
;;      include "<repo>/env/ir.atm"             ;; ir
;;      include "<repo>/env/espnow.atm"         ;; espnow (links Wi-Fi)
;;      include "<repo>/env/wifi.atm"           ;; wifi (STA, SoftAP, scan; links Wi-Fi)
;;      include "<repo>/env/preferences.atm"    ;; preferences
;;      include "<repo>/env/sleep.atm"          ;; sleep (deep/light sleep, RTC memory)
;;      include "<repo>/env/debug.atm"          ;; debug
;;
;; The modules call the drivers of drv/drv.h: those of the board
;; (drv/esp32/) or those simulated on the host (drv/host/). A module with
;; events registers in `esp32.drain` the function that emits the oldest
;; event of its driver. A module with a radio (`wifi`, `espnow`) registers
;; in `esp32.radios` the function that stops it, which `sleep` calls
;; before sleeping (the radios do not survive a sleep).

```:prelude
#include "drv.h"

// ESP32_FPS (the option ESP32_FPS of esp32/main/CMakeLists.txt): the
// clock never blocks, and each step emits :fps
#ifdef ESP32_FPS
#define ESP_FPS 1
#else
#define ESP_FPS 0
#endif

// The error of a driver, raised as an exception of the program.
static AStatus esp_chk (const char* err) {
    return (err == NULL) ? A_OK : a_error("%s", err);
}

// The argument `i` of the function `fn`, as an integer.
static AStatus esp_int (const char* fn, int i, AVal v, int64_t* out) {
    if (!a_isnum(v)) {
        return a_error("%s : expected a number as argument %d", fn, i);
    }
    *out = (int64_t) a_dbl(v);
    return A_OK;
}

// The argument `i` of the function `fn`, as a string.
static AStatus esp_str (const char* fn, int i, AVal v, const char** out) {
    if (v.type != A_STR) {
        return a_error("%s : expected a string as argument %d", fn, i);
    }
    *out = A_STR_OF(v)->s;
    return A_OK;
}

// An optional integer: nil is -1.
static AStatus esp_opt (const char* fn, int i, AVal v, int64_t* out) {
    if (v.type == A_NIL) {
        *out = -1;
        return A_OK;
    }
    return esp_int(fn, i, v, out);
}
// the time in the unit of the program (A_CLOCK_US microseconds each),
// with the rest kept for the next step
static int64_t esp_clk_rest = 0;
static int64_t esp_clock_step (AVal nxt) {
    int64_t max = (nxt.type == A_NIL) ? -1 : (int64_t) (a_dbl(nxt) * A_CLOCK_US);
    int64_t dt = drv_clock_wait(max);
    if (dt < 0) {
        return -1;
    }
    dt += esp_clk_rest;
    esp_clk_rest = dt % A_CLOCK_US;
    return dt / A_CLOCK_US;
}
```

;; `clock.now` is the time since boot, in the unit of the build
val clock = [now=0]

;; drain@<source of drv.h>: emits the oldest event of that driver
;; radios.<module>: stops the radio of that module (env/sleep.atm)
val esp32 = [drain=[], radios=[], fps=`:boolean ESP_FPS`]

atmos.env([
    mode = [primary=true],
    step = func () {
        val nxt = atmos.next()
        val dt = `:number esp_clock_step($nxt)`
        set clock.now = `:number drv_clock_now() / A_CLOCK_US`
        if dt < 0 {
            true            ;; nothing can happen anymore (only the host)
        } else {
            if dt > 0 {
                emit(dt)
            }
            loop {
                val src = `:number drv_next_source()`
                until src == 0
                esp32.drain@src()
            }
            if esp32.fps {
                emit(:fps)  ;; each step, as fast as possible
            }
            false
        }
    },
])
