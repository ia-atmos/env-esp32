;; Preferences: integers, booleans and strings kept in the flash (NVS),
;; under a namespace. One namespace is open at a time: `open` it, then
;; `put_*` and `get_*`, then `close`.
;;
;; A `put_*` commits at once, unless its last argument is `false`. A
;; `get_*` of an absent key gives its `default` (or nil).

```:prelude
static AStatus esp_prefs_key (const char* fn, AVal key, const char** out) {
    return esp_str(fn, 1, key, out);
}

static int esp_prefs_commit (AVal c) {
    return (c.type == A_NIL) || a_truthy(c);
}

static AStatus esp_prefs_open (AVal ns, AVal ro, AVal part) {
    const char* n = NULL; const char* p = NULL;
    AStatus st = esp_str("preferences.open", 1, ns, &n);
    if (st==A_OK && part.type!=A_NIL) st = esp_str("preferences.open", 3, part, &p);
    if (st == A_OK) st = esp_chk(drv_prefs_open(n, a_truthy(ro), p));
    return st;
}

static AStatus esp_prefs_put_int (AVal key, AVal v, AVal c) {
    const char* k = NULL; int64_t i = 0;
    AStatus st = esp_prefs_key("preferences.put_int", key, &k);
    if (st == A_OK) st = esp_int("preferences.put_int", 2, v, &i);
    if (st == A_OK) st = esp_chk(drv_prefs_put_int(k, (int32_t)i, esp_prefs_commit(c)));
    return st;
}

static AStatus esp_prefs_get_int (AVal key, AVal* ret) {
    const char* k = NULL; bool found = false; int32_t i = 0;
    AStatus st = esp_prefs_key("preferences.get_int", key, &k);
    if (st == A_OK) st = esp_chk(drv_prefs_get_int(k, &found, &i));
    if (found) a_set(ret, a_int(i));
    return st;
}

static AStatus esp_prefs_put_bool (AVal key, AVal v, AVal c) {
    const char* k = NULL;
    AStatus st = esp_prefs_key("preferences.put_bool", key, &k);
    if (st == A_OK) st = esp_chk(drv_prefs_put_bool(k, a_truthy(v), esp_prefs_commit(c)));
    return st;
}

static AStatus esp_prefs_get_bool (AVal key, AVal* ret) {
    const char* k = NULL; bool found = false; bool b = false;
    AStatus st = esp_prefs_key("preferences.get_bool", key, &k);
    if (st == A_OK) st = esp_chk(drv_prefs_get_bool(k, &found, &b));
    if (found) a_set(ret, a_bool(b));
    return st;
}

static AStatus esp_prefs_put_str (AVal key, AVal v, AVal c) {
    const char* k = NULL; const char* s = NULL;
    AStatus st = esp_prefs_key("preferences.put_string", key, &k);
    if (st == A_OK) st = esp_str("preferences.put_string", 2, v, &s);
    if (st == A_OK) st = esp_chk(drv_prefs_put_str(k, s, esp_prefs_commit(c)));
    return st;
}

static const char* esp_prefs_s;

static AStatus esp_prefs_get_str (AVal key, int* found) {
    const char* k = NULL; bool f = false;
    AStatus st = esp_prefs_key("preferences.get_string", key, &k);
    if (st == A_OK) st = esp_chk(drv_prefs_get_str(k, &f, &esp_prefs_s));
    *found = f;
    return st;
}

static AStatus esp_prefs_is_key (AVal key, AVal* ret) {
    const char* k = NULL; bool yes = false;
    AStatus st = esp_prefs_key("preferences.is_key", key, &k);
    if (st == A_OK) st = esp_chk(drv_prefs_is_key(k, &yes));
    a_set(ret, a_bool(yes));
    return st;
}

static AStatus esp_prefs_remove (AVal key, AVal c) {
    const char* k = NULL;
    AStatus st = esp_prefs_key("preferences.remove", key, &k);
    if (st == A_OK) st = esp_chk(drv_prefs_remove(k, esp_prefs_commit(c)));
    return st;
}

static int esp_prefs_found;
```

val preferences = []

;; namespace: 1 to 15 characters
func preferences.open (namespace, readonly, partition) {
    `st = esp_prefs_open($namespace, $readonly, $partition);`
    true
}
set preferences.begin = preferences.open

func preferences.close () {
    `st = esp_chk(drv_prefs_close());`
    true
}

func preferences.commit () {
    `st = esp_chk(drv_prefs_commit());`
    true
}

func preferences.put_int (key, value, commit) {
    `st = esp_prefs_put_int($key, $value, $commit);`
    true
}

func preferences.get_int (key, default) {
    var v = default
    `st = esp_prefs_get_int($key, &$v);`
    v
}

func preferences.put_bool (key, value, commit) {
    `st = esp_prefs_put_bool($key, $value, $commit);`
    true
}

func preferences.get_bool (key, default) {
    var v = default
    `st = esp_prefs_get_bool($key, &$v);`
    v
}

func preferences.put_string (key, value, commit) {
    `st = esp_prefs_put_str($key, $value, $commit);`
    true
}

func preferences.get_string (key, default) {
    `st = esp_prefs_get_str($key, &esp_prefs_found);`
    if `:boolean esp_prefs_found` => `:string esp_prefs_s` => default
}

func preferences.is_key (key) {
    var v = false
    `st = esp_prefs_is_key($key, &$v);`
    v
}

func preferences.remove (key, commit) {
    `st = esp_prefs_remove($key, $commit);`
    true
}

func preferences.clear (commit) {
    `st = esp_chk(drv_prefs_clear(esp_prefs_commit($commit)));`
    true
}
